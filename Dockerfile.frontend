FROM node:20-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
COPY packages/shared-types/package.json ./packages/shared-types/
COPY packages/shared-ui/package.json ./packages/shared-ui/
COPY apps/institution-web/package.json ./apps/institution-web/
COPY apps/user-h5/package.json ./apps/user-h5/
RUN npm ci

COPY packages/ ./packages/
COPY apps/ ./apps/
RUN npm run build

FROM nginx:1.27-alpine
COPY nginx/frontend.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/institution-web/dist /usr/share/nginx/institution
COPY --from=builder /app/apps/user-h5/dist /usr/share/nginx/h5
EXPOSE 80 8090
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=5 \
    CMD wget -q -O /dev/null http://127.0.0.1/health || exit 1
