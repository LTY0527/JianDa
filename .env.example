# Local development defaults. Copy to .env only for local use; never commit .env or real credentials.
MYSQL_DATABASE=jianda
MYSQL_USER=jianda
MYSQL_PASSWORD=jianda_dev_password
MYSQL_ROOT_PASSWORD=jianda_root_dev_password
MYSQL_PORT=3307
DB_URL=jdbc:mysql://mysql:3306/jianda?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=jianda
DB_PASSWORD=jianda_dev_password
JWT_SECRET=change-this-to-a-long-random-string-in-production
UPLOAD_DIR=/app/uploads
AI_SERVICE_URL=http://ai-service:8001
AI_PORT=8001
BACKEND_PORT=8080
H5_PORT=80
INSTITUTION_PORT=8090
LLM_PROVIDER=mock
EXTERNAL_LLM_API_KEY=
# Frontend Vite variables are build-time values. Leave VITE_API_BASE_URL empty for the local H5 /api proxy.
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8080
# Explicit comma-separated origins; never use * in production. Include actual Nginx frontend origins when deployed.
JIANDA_CORS_ALLOWED_ORIGINS=http://127.0.0.1,http://127.0.0.1:8090,http://localhost,http://localhost:8090,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174

# Production requirements:
# - Replace every *_PASSWORD and JWT_SECRET value with injected secrets.
# - Use a high-entropy JWT_SECRET and explicit deployed frontend origins.
# - Set SPRING_PROFILES_ACTIVE=prod when starting the backend outside Compose.
# - Do not use LLM_PROVIDER=external until a provider implementation is approved and deployed.
