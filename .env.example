# Local development defaults. Copy to .env only for local use; never commit .env or real credentials.
MYSQL_DATABASE=jianda
MYSQL_USER=jianda
MYSQL_PASSWORD=jianda_dev_password
MYSQL_ROOT_PASSWORD=jianda_root_dev_password
MYSQL_PORT=3307
DB_URL=jdbc:mysql://mysql:3306/jianda?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=jianda
DB_PASSWORD=jianda_dev_password
JWT_SECRET=change-this-to-a-long-random-string-in-production
UPLOAD_DIR=/app/uploads
AI_SERVICE_URL=http://ai-service:8001
JIANDA_PUBLIC_FIXTURE=
AI_PORT=8001
BACKEND_PORT=8080
H5_PORT=80
INSTITUTION_PORT=8090
LLM_PROVIDER=mock
ASSISTANT_EXTERNAL_ENABLED=false
ASSISTANT_DAILY_CALL_LIMIT=30
ASSISTANT_DAILY_TOKEN_LIMIT=30000
ASSISTANT_GLOBAL_DAILY_CALL_LIMIT=200
ASSISTANT_GLOBAL_DAILY_TOKEN_LIMIT=200000
ASSISTANT_RESIDENT_DAILY_CALL_LIMIT=20
ASSISTANT_RESIDENT_DAILY_TOKEN_LIMIT=30000
ASSISTANT_GUEST_DAILY_CALL_LIMIT=5
ASSISTANT_GUEST_DAILY_TOKEN_LIMIT=5000
EXTERNAL_LLM_BASE_URL=https://api.deepseek.com
EXTERNAL_LLM_API_KEY=
EXTERNAL_LLM_MODEL=deepseek-v4-flash
EXTERNAL_LLM_TIMEOUT_SECONDS=60
EXTERNAL_LLM_MAX_RETRIES=2
EXTERNAL_LLM_MAX_TOKENS=6000
EXTERNAL_LLM_THINKING=disabled
JIANDA_PROMPT_VERSION=v1.1
# Only for local proxy/VPN "fake-IP" DNS environments using 198.18.0.0/15.
# Keep false in production; private, loopback and other reserved networks remain blocked.
JIANDA_ALLOW_FAKE_IP_DNS=false
CRAWL_SCHEDULER_ENABLED=false
CRAWL_DAILY_TIME=03:30
CRAWL_TIMEZONE=Asia/Shanghai
CRAWL_MAX_ARTICLES_PER_SOURCE=5
CRAWL_GLOBAL_MAX_ARTICLES_PER_RUN=20
CRAWL_AUTO_AI_ENABLED=false
CRAWL_MAX_FAILURE_RETRIES=3
CRAWL_DAILY_AI_MAX_ARTICLES=5
CRAWL_DAILY_AI_MAX_TOKENS=50000
CRAWL_AI_MAX_INPUT_CHARACTERS=50000
CRAWL_AI_MAX_ARTICLES_PER_TASK=5
CRAWL_AI_CONSUMER_BATCH_SIZE=2
CRAWL_AI_CONSUMER_DELAY_MS=60000
WEB_IMAGE_CANDIDATES_ENABLED=true
HISTORICAL_COVER_BACKFILL_ENABLED=true
# Frontend Vite variables are build-time values. Leave VITE_API_BASE_URL empty for the local H5 /api proxy.
VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://127.0.0.1:8080
# Optional institution-to-H5 public origin, for example https://service.example.gov.cn.
# Empty means http://127.0.0.1:5174 in Vite DEV, or the current protocol + hostname in production.
VITE_H5_BASE_URL=
# Development-only sample import entry. Keep false for normal and production builds.
VITE_ENABLE_DEV_FIXTURES=false
# Explicit comma-separated origins; never use * in production. Include actual Nginx frontend origins when deployed.
JIANDA_CORS_ALLOWED_ORIGINS=http://127.0.0.1,http://127.0.0.1:8090,http://localhost,http://localhost:8090,http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174

# Production requirements:
# - Replace every *_PASSWORD and JWT_SECRET value with injected secrets.
# - Use a high-entropy JWT_SECRET and explicit deployed frontend origins.
# - Set SPRING_PROFILES_ACTIVE=prod when starting the backend outside Compose.
# - Keep LLM_PROVIDER=mock unless an approved external model account and data policy are ready.
